<div class="S_Happiness">
    <div class="A_Heading h2">меня порадовало
    </div>
    <div class="A_Text p"> <%= raw "я&nbsp;люблю рефлексировать о&nbsp;своих радостях и&nbsp;узнавать чужие"%>
    </div>

    <div class="C_HappinessBlocks">
    <% if @happiness_samples.present? %>
      <% @happiness_samples.each do |happiness| %>
        <div class="O_Happiness">
          <div class="W_HappinessTexts">
            <div class="W_HappinessTexts2">
              <div class="HappinessText h3"><%= happiness.text.html_safe %></div>
            </div>
            <div class="HappinessDate h3"><%= happiness.date %></div>
          </div>
          <% if happiness.image.present? %>
            <%= image_tag "happiness/#{happiness.image}", alt: "Image for #{happiness.text}" %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
  
    
</div>