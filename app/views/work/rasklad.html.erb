<div class="S_Case">
    <div class = "W_RaskladHead">
            <div class="A_Heading h2"> <%= link_to "кейсы /", work_path %> расклад💋</div>
            <div class="A_Text h3"><%= raw "медиа о&nbsp;таро для зумерок, сочетающее в&nbsp;себе онлайн-гадания в&nbsp;различных форматах, актуальные статьи о&nbsp;культуре таро и&nbsp;справочник с&nbsp;трактовками карт"%></div>
            <div class="A_Heading p Grey">время чтения: 6 мин</div>
            <%= image_tag 'rasklad/1.png', class: 'A_ImageRasklad1' %>
            <%= image_tag 'rasklad/2.png', class: 'A_ImageRasklad2' %>
            <%= image_tag 'rasklad/3.png', class: 'A_ImageRasklad3' %>
            <%= image_tag 'rasklad/4.png', class: 'A_ImageRasklad4' %>
    </div>
