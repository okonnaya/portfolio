                        <div class="A_Column1RaskladBody h3">
                            роль
                        </div>
                        <div class="A_Column2RaskladBody h3">
                            art direction
                            </br>
                            UX/UI
                            </br>
                            frontend developer
                            </br>
                            PR & social media
                        </div>
                    </div>
                    <div class="M_ColumnRaskladBody">
                        <div class="A_Column1RaskladBody h3">
                            дата
                        </div>
                        <div class="A_Column2RaskladBody h3">
                            сентябрь 2022 —
                            </br>
                            июнь 2023
                        </div>
                    </div>
