            <a class="h3" onClick="document.getElementById('section7').scrollIntoView({ behavior: 'smooth' });">3. решение</a>
            <a class="h3" onClick="document.getElementById('section4').scrollIntoView({ behavior: 'smooth' });">4. дизайн-система</a>
            <a class="h3" onClick="document.getElementById('section5').scrollIntoView({ behavior: 'smooth' });">5. интерфейсы</a>
            <a class="h3" onClick="document.getElementById('section6').scrollIntoView({ behavior: 'smooth' });">6. SEO</a>
            
        </div>
